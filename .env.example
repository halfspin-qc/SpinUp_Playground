# ==========================================
# JEV AI Experiments - Environment Template
# ==========================================
# NOTE: DO NOT commit your actual .env file to git!
# This repository is public. For safety, copy this file to .env
# or use the per-session API Key drawer in the web interface.

# ------------------------------------------
# 1. Apify Configuration (Google Reviews Scraper)
# ------------------------------------------
# Get your API token from: https://console.apify.com/account/integrations
APIFY_API_TOKEN=apify_api_your_token_here

# (Optional) Default dataset ID if you have already run a Google Maps Review scraper
APIFY_DEFAULT_DATASET_ID=

# ------------------------------------------
# 2. Supabase Configuration (Database Storage)
# ------------------------------------------
# Get these from your Supabase project: Settings -> API
# URL looks like: https://xyzcompany.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# Use the service_role key for server-side operations (bypasses RLS for sync & batch jobs)
# or anon key for read-only / public operations
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------
# 3. LLM Configuration (Review Classifier - TypeSafe Jev System One)
# ------------------------------------------
# Supported providers: "jev" (recommended) | "openai" | "gemini" | "groq"
LLM_PROVIDER=jev

# Model to use:
# - For jev:    "jev-latest" (TypeSafe System One: $0.042/Mtok input, $0 output, ~200-500ms)
# - For openai: "gpt-4o-mini"
# - For gemini: "gemini-2.5-flash"
# - For groq:   "llama-3.3-70b-versatile"
LLM_MODEL=jev-latest

# API key for Jev (TypeSafe):
JEV_API_KEY=your_jev_api_key_here

