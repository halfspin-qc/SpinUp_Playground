---
import Layout from '../layouts/Layout.astro';
---

<Layout title="SpinUp Experiments with AI" description="Explore bleeding-edge experiments with LLMs, Apify scrapers, and data pipelines.">
  <div class="container hub-container">
    <!-- Hero Header -->
    <section class="hero-section">
      <div class="hero-badge">
        <span class="pulse-dot"></span>
        <span>SpinUp Experiments with AI</span>
      </div>
      <h1 class="hero-title">
        Exploring Next-Gen LLMs & <br />
        <span class="gradient-text">Autonomous Data Pipelines</span>
      </h1>
      <p class="hero-desc">
        A collection of focused experimental applications connecting web scrapers, vector storage, and modern language models to turn raw unstructured internet data into structured, operational intelligence.
      </p>

      <div class="hero-actions">
        <a href="/jev-reviews" class="btn btn-primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
          Launch Featured: jev-reviews
        </a>
        <button class="btn btn-secondary" onclick="window.openKeyModal && window.openKeyModal()">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          Configure Session Keys
        </button>
      </div>
    </section>

    <!-- Architecture Strip -->
    <section class="pipeline-strip glass-card">
      <div class="strip-header">
        <h3>The Core Architecture Pattern</h3>
        <p>How data flows from public scrapers to structured LLM intelligence</p>
      </div>

      <div class="strip-steps">
        <div class="strip-step">
          <div class="step-num">01</div>
          <div class="step-icon">🕷️</div>
          <h4>Apify Scraper Storage</h4>
          <p>Extracts bulk Google Maps reviews with ratings, dates, and author metadata into cloud datasets.</p>
        </div>

        <div class="step-arrow">&rarr;</div>

        <div class="strip-step">
          <div class="step-num">02</div>
          <div class="step-icon">⚡</div>
          <h4>Supabase PostgreSQL</h4>
          <p>Deduplicates reviews, provides scalable JSONB document storage, and serves filtered real-time views.</p>
        </div>

        <div class="step-arrow">&rarr;</div>

        <div class="strip-step">
          <div class="step-num">03</div>
          <div class="step-icon">🧠</div>
          <h4>LLM Classification Engine</h4>
          <p>Processes text through OpenAI, Gemini, or Groq into sentiment, 5-pillar ratings, and owner action items.</p>
        </div>

        <div class="step-arrow">&rarr;</div>

        <div class="strip-step">
          <div class="step-num">04</div>
          <div class="step-icon">📊</div>
          <h4>Interactive Visual Hub</h4>
          <p>Explores restaurant performance, filters by complaints, and pinpoints operational opportunities.</p>
        </div>
      </div>
    </section>

    <!-- Experiments Grid -->
    <section class="experiments-section">
      <div class="section-title-wrap">
        <h2>Active & Upcoming Experiments</h2>
        <p>Select an experiment to explore its pipeline and analysis tools.</p>
      </div>

      <div class="experiments-grid">
        <!-- Experiment 1: JEV-Reviews (Active) -->
        <div class="experiment-card glass-card featured">
          <div class="card-badge active-badge">
            <span class="pulse-dot"></span> Active Experiment
          </div>
          <div class="card-body">
            <div class="card-icon">⭐</div>
            <h3 class="card-title">jev-reviews</h3>
            <p class="card-desc">
              Google Maps restaurant review intelligence pipeline. Ingests raw review scrapes from Apify datasets, deduplicates into Supabase, and uses LLMs to perform 5-pillar sentiment breakdown, dish extraction, and owner action recommendations.
            </p>

            <div class="tech-tags">
              <span class="tag">Apify</span>
              <span class="tag">Supabase</span>
              <span class="tag">GPT-4o / Gemini</span>
              <span class="tag">Sentiment NLP</span>
            </div>

            <div class="card-footer">
              <a href="/jev-reviews" class="btn btn-primary btn-sm full-width">
                Open jev-reviews Dashboard &rarr;
              </a>
            </div>
          </div>
        </div>

        <!-- Experiment 2: Menu Optimizer (Upcoming) -->
        <div class="experiment-card glass-card coming-soon">
          <div class="card-badge queue-badge">In Design</div>
          <div class="card-body">
            <div class="card-icon">📋</div>
            <h3 class="card-title">jev-menu-ai</h3>
            <p class="card-desc">
              Automated menu item profitability and sentiment correlation. Links reviews mentioning specific dishes to pricing and portion complaints to suggest menu revisions.
            </p>
            <div class="tech-tags">
              <span class="tag">Menu OCR</span>
              <span class="tag">LLM Correlation</span>
              <span class="tag">Pricing AI</span>
            </div>
            <div class="card-footer">
              <button class="btn btn-secondary btn-sm full-width" disabled>Coming Soon</button>
            </div>
          </div>
        </div>

        <!-- Experiment 3: Response Drafter (Upcoming) -->
        <div class="experiment-card glass-card coming-soon">
          <div class="card-badge queue-badge">In Design</div>
          <div class="card-body">
            <div class="card-icon">🤖</div>
            <h3 class="card-title">jev-reply-agent</h3>
            <p class="card-desc">
              Multi-persona autonomous customer review response agent. Crafts empathetic, brand-aligned public responses for negative and positive reviews tailored to management policy.
            </p>
            <div class="tech-tags">
              <span class="tag">Multi-Agent</span>
              <span class="tag">Brand Alignment</span>
              <span class="tag">Tone Calibration</span>
            </div>
            <div class="card-footer">
              <button class="btn btn-secondary btn-sm full-width" disabled>Coming Soon</button>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .hub-container {
    padding-top: 48px;
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  .hero-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 820px;
    margin: 0 auto;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.3);
    border-radius: var(--radius-full);
    font-size: 13px;
    font-weight: 600;
    color: #6ee7b7;
    margin-bottom: 24px;
  }

  .hero-title {
    font-size: clamp(32px, 5vw, 54px);
    line-height: 1.15;
    margin-bottom: 20px;
  }

  .hero-desc {
    font-size: clamp(16px, 2vw, 18px);
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 32px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    justify-content: center;
  }

  /* Pipeline Strip */
  .pipeline-strip {
    padding: 32px;
    border: 1px solid var(--border-subtle);
  }

  .strip-header {
    text-align: center;
    margin-bottom: 32px;
  }

  .strip-header h3 {
    font-size: 20px;
    margin-bottom: 6px;
  }

  .strip-header p {
    font-size: 14px;
    color: var(--text-muted);
  }

  .strip-steps {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
    align-items: center;
    gap: 12px;
  }

  @media (max-width: 900px) {
    .strip-steps {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .step-arrow {
      display: none;
    }
  }

  .strip-step {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 20px;
    position: relative;
    height: 100%;
  }

  .step-num {
    position: absolute;
    top: 14px;
    right: 14px;
    font-size: 12px;
    font-family: var(--font-mono);
    color: var(--text-dim);
    font-weight: 700;
  }

  .step-icon {
    font-size: 24px;
    margin-bottom: 12px;
  }

  .strip-step h4 {
    font-size: 15px;
    margin-bottom: 8px;
  }

  .strip-step p {
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .step-arrow {
    font-size: 20px;
    color: var(--text-dim);
    font-weight: 700;
  }

  /* Experiments Grid */
  .section-title-wrap {
    margin-bottom: 24px;
  }

  .section-title-wrap h2 {
    font-size: 24px;
    margin-bottom: 6px;
  }

  .section-title-wrap p {
    color: var(--text-muted);
    font-size: 14px;
  }

  .experiments-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 24px;
  }

  .experiment-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 28px;
    border-radius: var(--radius-md);
    transition: var(--transition);
  }

  .experiment-card.featured {
    border-color: rgba(16, 185, 129, 0.4);
    box-shadow: 0 10px 40px -10px rgba(16, 185, 129, 0.22);
  }

  .experiment-card.featured:hover {
    transform: translateY(-4px);
    border-color: rgba(16, 185, 129, 0.6);
  }

  .experiment-card.coming-soon {
    opacity: 0.65;
  }

  .card-badge {
    position: absolute;
    top: 20px;
    right: 20px;
    font-size: 11px;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: var(--radius-full);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .active-badge {
    background: rgba(16, 185, 129, 0.15);
    color: #34d399;
    border: 1px solid rgba(16, 185, 129, 0.3);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .queue-badge {
    background: rgba(148, 163, 184, 0.15);
    color: var(--text-dim);
  }

  .card-icon {
    font-size: 32px;
    margin-bottom: 16px;
  }

  .card-title {
    font-size: 20px;
    margin-bottom: 10px;
  }

  .card-desc {
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 20px;
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 24px;
  }

  .tag {
    font-size: 12px;
    font-weight: 500;
    padding: 3px 9px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    color: var(--text-muted);
  }

  .full-width {
    width: 100%;
  }
</style>
