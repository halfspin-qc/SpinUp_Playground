  // Bind Listeners
  document.addEventListener('DOMContentLoaded', () => {
    // Fill pre-saved dataset ID if present
    const creds = getSessionCreds();
    const dsInput = document.getElementById('apify-dataset-input') as HTMLInputElement;
    if (dsInput && creds.apifyDataset) dsInput.value = creds.apifyDataset;

    // Guide toggle
    const guideBox = document.getElementById('setup-guide-box');
    const toggleGuideBtn = document.getElementById('toggle-guide-btn');
    const closeGuideBtn = document.getElementById('close-guide-btn');

    if (toggleGuideBtn) {
      toggleGuideBtn.addEventListener('click', () => {
        if (guideBox) {
          guideBox.style.display = guideBox.style.display === 'none' ? 'block' : 'none';
        }
      });
    }

    if (closeGuideBtn) {
      closeGuideBtn.addEventListener('click', () => {
        if (guideBox) guideBox.style.display = 'none';
      });
    }

    // Detail Modal close
    const detailModal = document.getElementById('detail-modal-overlay');
    const closeDetail = document.getElementById('close-detail-modal');
    if (closeDetail && detailModal) {
      closeDetail.addEventListener('click', () => (detailModal.style.display = 'none'));
      detailModal.addEventListener('click', (e) => {
        if (e.target === detailModal) detailModal.style.display = 'none';
      });
    }

    // Toast close
    const toastClose = document.getElementById('toast-close');
    const toastBanner = document.getElementById('toast-banner');
    if (toastClose && toastBanner) {
      toastClose.addEventListener('click', () => (toastBanner.style.display = 'none'));
    }

    // View Switcher (Cards vs Matrix Table)
    const cardsContainer = document.getElementById('reviews-container');
    const tableContainer = document.getElementById('reviews-table-container');
    const btnCards = document.getElementById('view-mode-cards');
    const btnTable = document.getElementById('view-mode-table');

    btnCards?.addEventListener('click', () => {
      btnCards.classList.add('active');
      btnTable?.classList.remove('active');
      if (cardsContainer) cardsContainer.style.display = 'grid';
      if (tableContainer) tableContainer.style.display = 'none';
    });

    btnTable?.addEventListener('click', () => {
      btnTable.classList.add('active');
      btnCards?.classList.remove('active');
      if (cardsContainer) cardsContainer.style.display = 'none';
      if (tableContainer) tableContainer.style.display = 'block';
    });

    // Buttons
    document.getElementById('sync-apify-btn')?.addEventListener('click', syncFromApify);
    document.getElementById('run-classify-btn')?.addEventListener('click', () => classifyBatch());
    document.getElementById('refresh-reviews-btn')?.addEventListener('click', loadReviews);

    // Filters
    document.getElementById('filter-status')?.addEventListener('change', loadReviews);
    document.getElementById('filter-sentiment')?.addEventListener('change', loadReviews);
    document.getElementById('filter-search-input')?.addEventListener('input', () => {
      clearTimeout((window as any)._searchTimer);
      (window as any)._searchTimer = setTimeout(loadReviews, 300);
    });

    // React to session keys updated
    window.addEventListener('session-keys-updated', () => {
      loadReviews();
    });

    // Initial load
    loadReviews();
  });
</script>
