</style>

<script>
  // Frontend State and API Handlers
  let currentReviews: any[] = [];

  function getSessionCreds() {
    try {
      const raw = sessionStorage.getItem('jev_session_credentials');
      return raw ? JSON.parse(raw) : {};
    } catch {
      return {};
    }
  }

  function showToast(message: string, isError = false) {
    const banner = document.getElementById('toast-banner');
    const msg = document.getElementById('toast-message');
    if (!banner || !msg) return;

    msg.textContent = message;
    banner.style.display = 'flex';
    if (isError) {
      banner.style.background = 'rgba(244, 63, 94, 0.15)';
      banner.style.borderColor = 'rgba(244, 63, 94, 0.35)';
      banner.style.color = '#fecdd3';
    } else {
      banner.style.background = 'rgba(16, 185, 129, 0.15)';
      banner.style.borderColor = 'rgba(16, 185, 129, 0.35)';
      banner.style.color = '#a7f3d0';
    }

    setTimeout(() => {
      if (banner) banner.style.display = 'none';
    }, 6000);
  }

  async function loadReviews() {
    const creds = getSessionCreds();
    const status = (document.getElementById('filter-status') as HTMLSelectElement)?.value || 'all';
    const sentiment = (document.getElementById('filter-sentiment') as HTMLSelectElement)?.value || 'all';
    const search = (document.getElementById('filter-search-input') as HTMLInputElement)?.value || '';

    try {
      const res = await fetch('/api/reviews/list', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'x-supabase-url': creds.supabaseUrl || '',
          'x-supabase-key': creds.supabaseKey || '',
        },
        body: JSON.stringify({
          status,
          sentiment,
          restaurantName: search,
          limit: 100,
        }),
      });

      const data = await res.json();

      if (!res.ok) {
        renderReviews([], data.error || 'Failed to load reviews from Supabase.');
        return;
      }

      currentReviews = data.reviews || [];
      renderStats(data.summary || {});
      renderReviews(currentReviews);
    } catch (err: any) {
      renderReviews([], `Connection Error: ${err.message}. Please verify your Supabase URL & Key in Session Settings.`);
    }
  }

  function renderStats(summary: any) {
    const total = summary.total || 0;
    const processed = summary.processed || 0;
    const pending = summary.pending || 0;
    const avgRating = summary.avgRating || '0.0';
    const pos = summary.positiveCount || 0;
    const neu = summary.neutralCount || 0;
    const neg = summary.negativeCount || 0;

    const elTotal = document.getElementById('stat-total');
    const elProc = document.getElementById('stat-processed');
    const elProcPct = document.getElementById('stat-processed-pct');
    const elPending = document.getElementById('stat-pending');
    const elRating = document.getElementById('stat-rating');
    const elPos = document.getElementById('count-pos');
    const elNeu = document.getElementById('count-neu');
    const elNeg = document.getElementById('count-neg');

    if (elTotal) elTotal.textContent = String(total);
    if (elProc) elProc.textContent = String(processed);
    if (elProcPct) {
      const pct = total > 0 ? Math.round((processed / total) * 100) : 0;
      elProcPct.textContent = `${pct}% processed`;
    }
    if (elPending) elPending.textContent = String(pending);
    if (elRating) elRating.textContent = String(avgRating);

    if (elPos) elPos.textContent = String(pos);
    if (elNeu) elNeu.textContent = String(neu);
    if (elNeg) elNeg.textContent = String(neg);

    const barTotal = pos + neu + neg;
    const barPos = document.getElementById('bar-pos');
    const barNeu = document.getElementById('bar-neu');
    const barNeg = document.getElementById('bar-neg');

    if (barTotal > 0) {
      if (barPos) barPos.style.width = `${(pos / barTotal) * 100}%`;
      if (barNeu) barNeu.style.width = `${(neu / barTotal) * 100}%`;
      if (barNeg) barNeg.style.width = `${(neg / barTotal) * 100}%`;
    } else {
      if (barPos) barPos.style.width = '33%';
      if (barNeu) barNeu.style.width = '33%';
      if (barNeg) barNeg.style.width = '34%';
    }

    // Update Jev Speed & Cost metric KPI
    const jevItems = currentReviews.filter((r) => r.classification?.jevMeta);
    const elJevSpeed = document.getElementById('stat-jev-speed');
    const elJevCost = document.getElementById('stat-jev-cost');
    if (jevItems.length > 0) {
      const avgLat = Math.round(
        jevItems.reduce((acc, r) => acc + (r.classification.jevMeta.responseTimeMs || 250), 0) / jevItems.length
      );
      const totalCost = jevItems.reduce((acc, r) => acc + (r.classification.jevMeta.costUsd || 0.000017), 0);
      const totalToks = jevItems.reduce((acc, r) => acc + (r.classification.jevMeta.inputTokens || 400), 0);
      if (elJevSpeed) elJevSpeed.textContent = `~${avgLat}ms`;
      if (elJevCost) elJevCost.textContent = `$${totalCost.toFixed(5)} total (${totalToks} toks, $0.042/Mtok)`;
    } else {
      if (elJevSpeed) elJevSpeed.textContent = '~280ms';
      if (elJevCost) elJevCost.textContent = 'Est. ~$0.000018 / rev ($0.042/Mtok)';
    }
  }

  function getScoreBadgeHtml(scoreVal: number | undefined) {
    if (!scoreVal || scoreVal === 0) return '<span class="score-dim">-</span>';
    const cls = scoreVal >= 4 ? 'score-high' : scoreVal >= 3 ? 'score-mid' : 'score-low';
    return `<span class="score-badge-num ${cls}">${scoreVal}/5</span>`;
  }

  function renderReviews(reviews: any[], errorMsg?: string) {
    const container = document.getElementById('reviews-container');
    const tableBody = document.getElementById('matrix-table-body');
    if (!container) return;

    if (errorMsg) {
      container.innerHTML = `
        <div class="empty-state">
          <div style="font-size: 32px;">⚠️</div>
          <h4>Database Connection Notice</h4>
          <p style="max-width: 500px;">${errorMsg}</p>
          <div style="display: flex; gap: 12px; margin-top: 10px; flex-wrap: wrap; justify-content: center;">
            <button class="btn btn-primary btn-sm" onclick="window.openKeyModal && window.openKeyModal()">
              Configure Credentials
            </button>
            <button id="load-sample-notice-btn" class="btn btn-secondary btn-sm">
              Explore Demo Mode (Sample Data)
            </button>
          </div>
        </div>
      `;
      if (tableBody) tableBody.innerHTML = `<tr><td colspan="11" style="text-align: center; padding: 24px; color: var(--text-dim);">${escapeHtml(errorMsg)}</td></tr>`;
      const sampleBtn = document.getElementById('load-sample-notice-btn');
      if (sampleBtn) sampleBtn.addEventListener('click', loadSampleReviews);
      return;
    }

    if (reviews.length === 0) {
      container.innerHTML = `
        <div class="empty-state">
          <div style="font-size: 36px;">🍽️</div>
          <h4>No Reviews Ingested Yet</h4>
          <p style="max-width: 460px;">Sync reviews from an Apify Google Scraper Dataset using the control bar above, or load sample reviews to test the LLM classifier immediately.</p>
          <button id="load-sample-btn" class="btn btn-secondary btn-sm" style="margin-top: 8px;">
            Load Mock Restaurant Reviews (Demo)
          </button>
        </div>
      `;
      if (tableBody) tableBody.innerHTML = `<tr><td colspan="11" style="text-align: center; padding: 24px; color: var(--text-dim);">No reviews to display. Sync from Apify or click "Load Mock Restaurant Reviews (Demo)".</td></tr>`;
      const sampleBtn = document.getElementById('load-sample-btn');
      if (sampleBtn) sampleBtn.addEventListener('click', loadSampleReviews);
      return;
    }

    // 1. Render Cards View
    container.innerHTML = reviews
      .map((r) => {
        const ratingStars = '★'.repeat(Math.round(r.rating || 5)) + '☆'.repeat(5 - Math.round(r.rating || 5));
        const sentimentPillClass =
          r.status === 'error'
            ? 'pill-error'
            : r.sentiment === 'positive'
              ? 'pill-positive'
              : r.sentiment === 'negative'
                ? 'pill-negative'
                : r.sentiment === 'neutral'
                  ? 'pill-neutral'
                  : 'pill-pending';

        const classification = r.classification || {};
        const summary = classification.oneSentenceSummary || null;
        const dishes = Array.isArray(classification.dishesMentioned) ? classification.dishesMentioned : [];
        const cats = classification.categories || {};
        const jevMeta = classification.jevMeta;
        const hasAnyPillars = cats.foodQuality?.rating || cats.service?.rating || cats.cleanliness?.rating || cats.atmosphere?.rating || cats.valueForMoney?.rating;

        return `
          <div class="glass-card review-card" data-id="${r.id}">
            <div class="review-head">
              <div>
                <h4 class="restaurant-title">${escapeHtml(r.restaurant_name)}</h4>
                <div class="author-meta">
                  ${escapeHtml(r.reviewer_name || 'Google User')} &bull; ${r.published_at ? new Date(r.published_at).toLocaleDateString() : 'Recent'}
                </div>
                <div class="rating-stars">${ratingStars}</div>
              </div>
              <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 6px;">
                <span class="pill ${sentimentPillClass}" title="${escapeHtml(r.raw_data?.classification_error || '')}">
                  ${r.status === 'error' ? 'Error' : r.sentiment || r.status}
                </span>
                ${
                  jevMeta
                    ? `<span class="jev-card-badge" title="TypeSafe System One (${escapeHtml(jevMeta.model || 'jev-latest')}): ${jevMeta.inputTokens || 0} tokens in, 0 tokens out">⚡ ${jevMeta.responseTimeMs ? jevMeta.responseTimeMs + 'ms' : '< 300ms'} &bull; ${jevMeta.costFormatted || '$0.000017'}</span>`
                    : ''
                }
              </div>
            </div>

            <p class="review-body-text">${escapeHtml(r.review_text || '(No text provided)')}</p>

            ${
              hasAnyPillars
                ? `
              <div class="card-pillars-strip">
                <span class="mini-score-chip" title="Food Quality: ${escapeHtml(cats.foodQuality?.note || '')}">🍽️ Food: ${cats.foodQuality?.rating ? cats.foodQuality.rating + '/5' : '-'}</span>
                <span class="mini-score-chip" title="Service: ${escapeHtml(cats.service?.note || '')}">🛎️ Svc: ${cats.service?.rating ? cats.service.rating + '/5' : '-'}</span>
                <span class="mini-score-chip" title="Cleanliness: ${escapeHtml(cats.cleanliness?.note || '')}">✨ Clean: ${cats.cleanliness?.rating ? cats.cleanliness.rating + '/5' : '-'}</span>
                <span class="mini-score-chip" title="Atmosphere: ${escapeHtml(cats.atmosphere?.note || '')}">🕯️ Atmo: ${cats.atmosphere?.rating ? cats.atmosphere.rating + '/5' : '-'}</span>
                <span class="mini-score-chip" title="Value: ${escapeHtml(cats.valueForMoney?.note || '')}">💵 Val: ${cats.valueForMoney?.rating ? cats.valueForMoney.rating + '/5' : '-'}</span>
              </div>
            `
                : ''
            }

            ${
              summary
                ? `
              <div class="classification-highlight">
                <span class="summary-preview">"${escapeHtml(summary)}"</span>
                ${
                  dishes.length > 0
                    ? `
                  <div class="dishes-pills">
                    ${dishes
                      .slice(0, 3)
                      .map((d: string) => `<span class="dish-tag">🍜 ${escapeHtml(d)}</span>`)
                      .join('')}
                  </div>
                `
                    : ''
                }
              </div>
            `
                : ''
            }

            <div class="review-footer">
              <span style="font-size: 11px; color: var(--text-dim);">ID: ${r.id.slice(0, 10)}...</span>
              <div style="display: flex; gap: 8px;">
                ${
                  r.status === 'processed'
                    ? `<button class="btn btn-secondary btn-sm inspect-btn" data-id="${r.id}">Inspect Jev / LLM</button>`
                    : `<button class="btn btn-secondary btn-sm classify-single-btn" data-id="${r.id}">${r.status === 'error' ? 'Retry with Jev' : 'Classify with Jev'}</button>`
                }
              </div>
            </div>
          </div>
        `;
      })
      .join('');

    // 2. Render Matrix Table View
    if (tableBody) {
      tableBody.innerHTML = reviews
        .map((r) => {
          const classification = r.classification || {};
          const cats = classification.categories || {};
          const jevMeta = classification.jevMeta;
          const sentimentPillClass =
            r.status === 'error'
              ? 'pill-error'
              : r.sentiment === 'positive'
                ? 'pill-positive'
                : r.sentiment === 'negative'
                  ? 'pill-negative'
                  : r.sentiment === 'neutral'
                    ? 'pill-neutral'
                    : 'pill-pending';

          const scoreVal = classification.sentimentScore || r.sentiment_score;

          return `
            <tr>
              <td>
                <div class="table-rest-title">${escapeHtml(r.restaurant_name)}</div>
                <div class="table-rest-meta">${escapeHtml(r.reviewer_name || 'Google User')} &bull; ${r.published_at ? new Date(r.published_at).toLocaleDateString() : 'Recent'}</div>
              </td>
              <td>
                <span style="color: #facc15; font-weight: 600;">★ ${r.rating ? Number(r.rating).toFixed(1) : '-'}</span>
              </td>
              <td>
                <span class="pill ${sentimentPillClass}" title="${escapeHtml(r.raw_data?.classification_error || '')}">${r.status === 'error' ? 'Error' : r.sentiment || r.status}</span>
              </td>
              <td>
                ${scoreVal ? `<b>${Number(scoreVal).toFixed(1)}</b> <span class="score-dim">/ 5.0</span>` : '<span class="score-dim">-</span>'}
              </td>
              <td>${getScoreBadgeHtml(cats.foodQuality?.rating)}</td>
              <td>${getScoreBadgeHtml(cats.service?.rating)}</td>
              <td>${getScoreBadgeHtml(cats.cleanliness?.rating)}</td>
              <td>${getScoreBadgeHtml(cats.atmosphere?.rating)}</td>
              <td>${getScoreBadgeHtml(cats.valueForMoney?.rating)}</td>
              <td>
                ${
                  jevMeta
                    ? `<span class="jev-card-badge" title="TypeSafe System One: ${jevMeta.inputTokens || 0} tokens in">⚡ ${jevMeta.responseTimeMs ? jevMeta.responseTimeMs + 'ms' : '< 300ms'} &bull; ${jevMeta.costFormatted || '$0.00004'}</span>`
                    : '<span class="score-dim">-</span>'
                }
              </td>
              <td>
                ${
                  r.status === 'processed'
                    ? `<button class="btn btn-secondary btn-sm inspect-btn" data-id="${r.id}" style="padding: 4px 10px; font-size: 11px;">Inspect</button>`
                    : `<button class="btn ${r.status === 'error' ? 'btn-secondary' : 'btn-primary'} btn-sm classify-single-btn" data-id="${r.id}" style="padding: 4px 10px; font-size: 11px;">${r.status === 'error' ? 'Retry' : 'Classify'}</button>`
                }
              </td>
            </tr>
          `;
        })
        .join('');
    }

    // Attach inspect & classify handlers across both cards and table
    document.querySelectorAll('.inspect-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = (btn as HTMLElement).dataset.id;
        const found = currentReviews.find((r) => r.id === id);
        if (found) openDetailModal(found);
      });
    });

    document.querySelectorAll('.classify-single-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = (btn as HTMLElement).dataset.id;
        if (id) await classifyBatch(id);
      });
    });
  }

  function escapeHtml(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function openDetailModal(review: any) {
    const modal = document.getElementById('detail-modal-overlay');
    if (!modal) return;

    const restName = document.getElementById('modal-rest-name');
    const reviewerMeta = document.getElementById('modal-reviewer-meta');
    const stars = document.getElementById('modal-stars');
    const ratingNum = document.getElementById('modal-rating-num');
    const reviewText = document.getElementById('modal-review-text');

    const sentimentPill = document.getElementById('modal-sentiment-pill');
    const scorePill = document.getElementById('modal-score-pill');
    const summaryText = document.getElementById('modal-summary-text');

    if (restName) restName.textContent = review.restaurant_name;
    if (reviewerMeta)
      reviewerMeta.textContent = `${review.reviewer_name || 'Google User'} • ${review.published_at ? new Date(review.published_at).toLocaleDateString() : 'Scraped'}`;
    if (stars)
      stars.textContent =
        '★'.repeat(Math.round(review.rating || 5)) + '☆'.repeat(5 - Math.round(review.rating || 5));
    if (ratingNum) ratingNum.textContent = review.rating ? `${review.rating} / 5.0` : 'No rating';
    if (reviewText) reviewText.textContent = review.review_text || '(No text provided)';

    const cls = review.classification || {};
    if (sentimentPill) {
      sentimentPill.textContent = (cls.overallSentiment || review.sentiment || 'Pending').toUpperCase();
      sentimentPill.className = `pill ${review.sentiment === 'positive' ? 'pill-positive' : review.sentiment === 'negative' ? 'pill-negative' : 'pill-neutral'}`;
    }
    if (scorePill) {
      scorePill.textContent = `Score: ${cls.sentimentScore || review.sentiment_score || review.rating || '-'}/5.0`;
    }
    if (summaryText) {
      summaryText.textContent = cls.oneSentenceSummary || 'Not classified yet. Click Run Classifier to analyze.';
    }

    // Jev System One Telemetry Box
    const jevBox = document.getElementById('modal-jev-box');
    if (jevBox) {
      if (cls.jevMeta) {
        jevBox.style.display = 'block';
        const modelEl = document.getElementById('modal-jev-model');
        const latEl = document.getElementById('modal-jev-latency');
        const costEl = document.getElementById('modal-jev-cost');
        const confEl = document.getElementById('modal-jev-conf');
        const probsGrid = document.getElementById('modal-jev-probs');

        if (modelEl) modelEl.textContent = `Jev System One (${cls.jevMeta.model || 'jev-latest'})`;
        if (latEl) latEl.textContent = cls.jevMeta.responseTimeMs ? `${cls.jevMeta.responseTimeMs}ms` : '< 300ms';
        if (costEl) costEl.textContent = `${cls.jevMeta.costFormatted || '$0.000018'} (${cls.jevMeta.inputTokens || 0} in / 0 out)`;
        if (confEl) {
          let confStr = '98%';
          if (typeof cls.jevMeta.confidence === 'number') {
            confStr = `${Math.round(cls.jevMeta.confidence * 100)}%`;
          } else if (cls.jevMeta.confidence && typeof cls.jevMeta.confidence === 'object') {
            const vals = Object.values(cls.jevMeta.confidence).filter((n): n is number => typeof n === 'number');
            if (vals.length > 0) {
              const avg = vals.reduce((a, b) => a + b, 0) / vals.length;
              confStr = `${Math.round(avg * 100)}%`;
            }
          }
          confEl.textContent = confStr;
        }
        if (probsGrid && cls.jevMeta.probabilities) {
          probsGrid.innerHTML = Object.entries(cls.jevMeta.probabilities)
            .map(([k, v]) => {
              let valText = '';
              if (typeof v === 'number') {
                valText = v <= 1 ? `${(v * 100).toFixed(1)}%` : String(v);
              } else if (typeof v === 'object' && v !== null) {
                valText = Object.entries(v)
                  .map(([subK, subV]) => `${subK}: ${typeof subV === 'number' ? Math.round(subV * 100) + '%' : subV}`)
                  .join(', ');
              } else {
                valText = String(v);
              }
              return `<span class="prob-chip">${escapeHtml(k.replace(/_/g, ' '))}: <b>${escapeHtml(valText)}</b></span>`;
            })
            .join('');
        }
      } else {
        jevBox.style.display = 'none';
      }
    }

    // Pillars
    const cats = cls.categories || {};
    setCategoryPillar('food', cats.foodQuality);
    setCategoryPillar('service', cats.service);
    setCategoryPillar('clean', cats.cleanliness);
    setCategoryPillar('atmo', cats.atmosphere);
    setCategoryPillar('val', cats.valueForMoney);

    // Highlights
    const hlList = document.getElementById('modal-highlights-list');
    if (hlList) {
      const hls = cls.positiveHighlights || [];
      hlList.innerHTML = hls.length > 0 ? hls.map((h: string) => `<li>${escapeHtml(h)}</li>`).join('') : '<li>None noted.</li>';
    }

    // Complaints
    const compList = document.getElementById('modal-complaints-list');
    if (compList) {
      const comps = cls.criticalComplaints || [];
      compList.innerHTML = comps.length > 0 ? comps.map((c: string) => `<li>${escapeHtml(c)}</li>`).join('') : '<li>None noted.</li>';
    }

    // Dishes
    const dishesWrap = document.getElementById('modal-dishes-wrap');
    if (dishesWrap) {
      const dishes = cls.dishesMentioned || [];
      dishesWrap.innerHTML = dishes.length > 0 ? dishes.map((d: string) => `<span class="dish-tag">🍜 ${escapeHtml(d)}</span>`).join('') : '<span class="tag">None mentioned</span>';
    }

    // Action Items
    const actionsList = document.getElementById('modal-actions-list');
    if (actionsList) {
      const acts = cls.actionItemsForOwner || [];
      actionsList.innerHTML = acts.length > 0 ? acts.map((a: string) => `<li>${escapeHtml(a)}</li>`).join('') : '<li>Continue maintaining current quality standards.</li>';
    }

    modal.style.display = 'flex';
  }

  function setCategoryPillar(prefix: string, item: any) {
    const scoreEl = document.getElementById(`pillar-${prefix}-score`);
    const noteEl = document.getElementById(`pillar-${prefix}-note`);
    if (!scoreEl || !noteEl) return;

    if (!item || !item.rating) {
      scoreEl.textContent = '-';
      noteEl.textContent = 'Not mentioned';
    } else {
      scoreEl.textContent = `${item.rating}/5`;
      noteEl.textContent = item.note || 'Assessed';
    }
  }

  async function syncFromApify() {
    const creds = getSessionCreds();
    const datasetInput = document.getElementById('apify-dataset-input') as HTMLInputElement;
    const limitSelect = document.getElementById('apify-sync-limit') as HTMLSelectElement;
    const syncBtn = document.getElementById('sync-apify-btn') as HTMLButtonElement;

    const datasetId = datasetInput?.value.trim() || creds.apifyDataset;
    const limit = Number(limitSelect?.value) || 50;

    if (!datasetId) {
      showToast('Please provide an Apify Dataset ID to sync reviews.', true);
      if (datasetInput) datasetInput.focus();
      return;
    }

    syncBtn.disabled = true;
    syncBtn.innerHTML = `<span class="pulse-dot"></span> Syncing...`;

    try {
      const res = await fetch('/api/apify/sync', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          datasetId,
          limit,
          apifyToken: creds.apifyToken,
          supabaseUrl: creds.supabaseUrl,
          supabaseKey: creds.supabaseKey,
        }),
      });

      const data = await res.json();
      if (!res.ok) {
        showToast(`Sync Failed: ${data.error}`, true);
      } else {
        showToast(data.message || `Successfully synced ${data.synced} reviews!`);
        await loadReviews();
      }
    } catch (err: any) {
      showToast(`Network error syncing Apify: ${err.message}`, true);
    } finally {
      syncBtn.disabled = false;
      syncBtn.innerHTML = `
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        Sync to Supabase
      `;
    }
  }

  async function classifyBatch(singleId?: string) {
    const creds = getSessionCreds();
    const batchSelect = document.getElementById('classify-batch-size') as HTMLSelectElement;
    const runBtn = document.getElementById('run-classify-btn') as HTMLButtonElement;

    const batchSize = Number(batchSelect?.value) || 5;

    runBtn.disabled = true;
    runBtn.innerHTML = `<span class="pulse-dot"></span> Classifying with LLM...`;

    try {
      const res = await fetch('/api/reviews/classify', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          reviewId: singleId || undefined,
          batchSize,
          supabaseUrl: creds.supabaseUrl,
          supabaseKey: creds.supabaseKey,
          llmProvider: creds.llmProvider || 'jev',
          llmApiKey: creds.llmApiKey || creds.jevApiKey,
          llmModel: creds.llmModel || 'jev-latest',
          jevApiKey: creds.jevApiKey || creds.llmApiKey,
        }),
      });

      const data = await res.json();
      if (!res.ok) {
        showToast(`LLM Classification Error: ${data.error}`, true);
      } else {
        showToast(data.message || `Classified ${data.processedCount} reviews!`);
        await loadReviews();
      }
    } catch (err: any) {
      showToast(`Network error: ${err.message}`, true);
    } finally {
      runBtn.disabled = false;
      runBtn.innerHTML = `
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polygon points="5 3 19 12 5 21 5 3"></polygon>
        </svg>
        Run Classifier
      `;
    }
  }

