---
import Layout from '../layouts/Layout.astro';
---

<Layout title="jev-reviews: Google Review Scrapes & LLM Classifier" description="Scrape Google restaurant reviews from Apify, store in Supabase, and classify with LLM intelligence.">
  <div class="container app-container">
    <!-- Top Bar / Title -->
    <div class="page-header">
      <div class="header-titles">
        <div class="breadcrumb">
          <a href="/">Experiments Hub</a>
          <span>/</span>
          <span class="active">jev-reviews</span>
        </div>
        <h1>Google Restaurant Reviews & LLM Classifier</h1>
        <p class="subtitle">Extract reviews from Apify storage &bull; Persist in Supabase &bull; Classify sentiment, food quality, service, and owner action items with LLMs.</p>
      </div>

      <div class="header-actions">
        <button id="toggle-guide-btn" class="btn btn-secondary" type="button">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
            <line x1="12" y1="17" x2="12.01" y2="17"></line>
          </svg>
          Step-by-Step Setup Guide
        </button>
        <button class="btn btn-secondary" onclick="window.openKeyModal && window.openKeyModal()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          API Keys
        </button>
      </div>
    </div>

    <!-- Step-by-Step Setup Drawer / Collapsible Guide -->
    <div id="setup-guide-box" class="guide-box glass-card" style="display: none;">
      <div class="guide-header">
        <div class="guide-header-title">
          <span class="guide-icon">📖</span>
          <h3>Step-by-Step Integration Guide (Apify &rarr; Supabase &rarr; LLM)</h3>
        </div>
        <button id="close-guide-btn" class="close-guide-btn">&times;</button>
      </div>

      <div class="guide-steps-grid">
        <!-- Step 1 -->
        <div class="guide-step-card">
          <div class="step-badge">Step 1</div>
          <h4>Apify Google Reviews Scraper</h4>
          <p>Scrapes customer reviews from any restaurant on Google Maps.</p>
          <ol class="guide-list">
            <li>Create a free account at <a href="https://apify.com" target="_blank" class="text-link">Apify.com</a>.</li>
            <li>Use the <strong>Google Maps Reviews Scraper</strong> actor (e.g. <code>compass/crawler-google-places</code>).</li>
            <li>Run the actor with your target restaurant Google Maps URL.</li>
            <li>Under <strong>Storage &rarr; Datasets</strong>, copy your <strong>Dataset ID</strong> (looks like <code>wFhK87S9y...</code>).</li>
            <li>Copy your <strong>API Token</strong> from Apify Console &rarr; Integrations.</li>
          </ol>
        </div>

        <!-- Step 2 -->
        <div class="guide-step-card">
          <div class="step-badge">Step 2</div>
          <h4>Supabase Database Setup</h4>
          <p>Creates the structured PostgreSQL table & indexes for reviews.</p>
          <ol class="guide-list">
            <li>Create a free project at <a href="https://supabase.com" target="_blank" class="text-link">Supabase.com</a>.</li>
            <li>Open the <strong>SQL Editor</strong> in your Supabase dashboard.</li>
            <li>Copy and paste the entire contents of <code>supabase/schema.sql</code> from this repo.</li>
            <li>Click <strong>Run</strong>. This creates the <code>restaurant_reviews</code> table, RLS policies, and stats views.</li>
            <li>Copy your <strong>Project URL</strong> and <strong>Service Role Key</strong> (or Anon Key) from Project Settings &rarr; API.</li>
          </ol>
        </div>

        <!-- Step 3 -->
        <div class="guide-step-card">
          <div class="step-badge">Step 3</div>
          <h4>Jev Model Classification</h4>
          <p>Instant decision classification for sorting, scoring, and calibrated probabilities.</p>
          <ol class="guide-list">
            <li><strong>Model:</strong> <code>jev-latest</code> (TypeSafe System One: <code>https://api.typesafe.ai/v1/systemone</code>).</li>
            <li><strong>Pricing:</strong> $42 per billion tokens (<strong>$0.042 / Mtok</strong> input). Output tokens are free ($0.00).</li>
            <li><strong>Speed:</strong> Sub-second response time (~200–500ms) with zero hallucinated fluff.</li>
            <li><strong>Answer Shapes:</strong> <em>Choice</em> (options), <em>Score</em> (scales), and <em>Noul</em> (yes/no probabilities).</li>
            <li>Add <code>JEV_API_KEY</code> to <code>.env</code> or click <strong>API Keys</strong> in the top header.</li>
          </ol>
        </div>
      </div>
    </div>

    <!-- Notification Toast Bar -->
    <div id="toast-banner" class="toast-banner" style="display: none;">
      <span id="toast-message">Notification</span>
      <button id="toast-close" class="toast-close">&times;</button>
    </div>

    <!-- Pipeline KPI Metrics Bar -->
    <div class="kpi-grid">
      <div class="kpi-card glass-card">
        <span class="kpi-label">Total Reviews</span>
        <div class="kpi-value-wrap">
          <span id="stat-total" class="kpi-value">0</span>
          <span class="kpi-icon">📁</span>
        </div>
        <span class="kpi-sub">Stored in Supabase</span>
      </div>

      <div class="kpi-card glass-card">
        <span class="kpi-label">Classified Reviews</span>
        <div class="kpi-value-wrap">
          <span id="stat-processed" class="kpi-value text-accent">0</span>
          <span class="kpi-icon">🧠</span>
        </div>
        <span class="kpi-sub" id="stat-processed-pct">0% processed</span>
      </div>

      <div class="kpi-card glass-card">
        <span class="kpi-label">Pending</span>
        <div class="kpi-value-wrap">
          <span id="stat-pending" class="kpi-value text-amber">0</span>
          <span class="kpi-icon">⏳</span>
        </div>
        <span class="kpi-sub">Awaiting classification</span>
      </div>

      <div class="kpi-card glass-card">
        <span class="kpi-label">Jev Speed & Cost</span>
        <div class="kpi-value-wrap">
          <span id="stat-jev-speed" class="kpi-value text-accent">~280ms</span>
          <span class="kpi-icon">⚡</span>
        </div>
        <span class="kpi-sub" id="stat-jev-cost">Est. ~$0.000018 / rev ($0.042/Mtok)</span>
      </div>

      <div class="kpi-card glass-card">
        <span class="kpi-label">Avg Google Rating</span>
        <div class="kpi-value-wrap">
          <span id="stat-rating" class="kpi-value text-yellow">0.0</span>
          <span class="kpi-icon">⭐</span>
        </div>
        <span class="kpi-sub">Across scraped reviews</span>
      </div>

      <div class="kpi-card glass-card">
        <span class="kpi-label">Sentiment Breakdown</span>
        <div class="sentiment-bar-wrap">
          <div class="sentiment-bar">
            <div id="bar-pos" class="bar-fill pos" style="width: 33%" title="Positive"></div>
            <div id="bar-neu" class="bar-fill neu" style="width: 33%" title="Neutral"></div>
            <div id="bar-neg" class="bar-fill neg" style="width: 34%" title="Negative"></div>
          </div>
          <div class="sentiment-counts">
            <span class="count-tag text-green"><b id="count-pos">0</b> Pos</span>
            <span class="count-tag text-amber"><b id="count-neu">0</b> Neu</span>
            <span class="count-tag text-red"><b id="count-neg">0</b> Neg</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Pipeline Control Panel -->
    <div class="control-panel glass-card">
      <div class="panel-section">
        <div class="section-heading">
          <div class="step-pill">Stage 1</div>
          <h3>Sync from Apify Storage</h3>
        </div>
        <p class="section-desc">Fetch Google reviews scraped into your Apify Dataset and upsert into Supabase.</p>
        
        <div class="sync-form-row">
          <input type="text" id="apify-dataset-input" class="input-field" placeholder="Enter Apify Dataset ID (e.g. wFhK87S9y...)" />
          <select id="apify-sync-limit" class="select-field limit-select">
            <option value="25">Sync 25</option>
            <option value="50" selected>Sync 50</option>
            <option value="100">Sync 100</option>
          </select>
          <button id="sync-apify-btn" class="btn btn-primary" type="button">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Sync to Supabase
          </button>
        </div>
      </div>

      <div class="panel-divider"></div>

      <div class="panel-section">
        <div class="section-heading">
          <div class="step-pill">Stage 2</div>
          <h3>Run LLM Review Classifier</h3>
        </div>
        <p class="section-desc">Analyze unclassified reviews with LLM to extract 5-pillar ratings, dishes, and owner insights.</p>

        <div class="classify-form-row">
          <div class="batch-select-wrap">
            <label for="classify-batch-size">Batch Size:</label>
            <select id="classify-batch-size" class="select-field">
              <option value="5">5 reviews</option>
              <option value="10" selected>10 reviews</option>
              <option value="25">25 reviews</option>
              <option value="50">50 reviews (Fast with Jev)</option>
            </select>
          </div>
          <button id="run-classify-btn" class="btn btn-primary" type="button">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
            Run Classifier
          </button>
          <button id="refresh-reviews-btn" class="btn btn-secondary" type="button" title="Refresh data">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M23 4v6h-6"></path>
              <path d="M1 20v-6h6"></path>
              <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
            </svg>
            Refresh
          </button>
        </div>
      </div>
    </div>

    <!-- Filter & Search Toolbar -->
    <div class="toolbar glass-card">
      <div class="search-wrap">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="search-icon">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input type="text" id="filter-search-input" class="search-input" placeholder="Search reviews by restaurant name or text..." />
      </div>

      <div class="filter-group">
        <label for="filter-status">Status:</label>
        <select id="filter-status" class="select-field filter-select">
          <option value="all">All Statuses</option>
          <option value="processed">Processed (Classified)</option>
          <option value="pending">Pending</option>
          <option value="error">Error</option>
        </select>
      </div>

      <div class="filter-group">
        <label for="filter-sentiment">Sentiment:</label>
        <select id="filter-sentiment" class="select-field filter-select">
          <option value="all">All Sentiments</option>
          <option value="positive">Positive</option>
          <option value="neutral">Neutral</option>
          <option value="negative">Negative</option>
        </select>
      </div>

      <!-- View Switcher: Cards vs Table Matrix -->
      <div class="view-toggle-group">
        <button id="view-mode-cards" class="view-toggle-btn active" type="button" title="Grid Cards View">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="7" height="7"></rect>
            <rect x="14" y="3" width="7" height="7"></rect>
            <rect x="14" y="14" width="7" height="7"></rect>
            <rect x="3" y="14" width="7" height="7"></rect>
          </svg>
          Cards View
        </button>
        <button id="view-mode-table" class="view-toggle-btn" type="button" title="Operational Score Matrix Table View">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
          Score Matrix Table
        </button>
      </div>
    </div>

    <!-- Reviews Grid (Cards View) -->
    <div id="reviews-container" class="reviews-grid">
      <div class="loading-state">
        <span class="pulse-dot"></span>
        <p>Connecting to database & loading reviews...</p>
      </div>
    </div>

    <!-- Reviews Operational Matrix Table View -->
    <div id="reviews-table-container" class="glass-card table-wrapper" style="display: none;">
      <div class="table-scroll">
        <table class="matrix-table">
          <thead>
            <tr>
              <th>Restaurant & Reviewer</th>
              <th>Rating</th>
              <th>Sentiment</th>
              <th>Score</th>
              <th title="Food Quality Rating (1-5)">🍽️ Food</th>
              <th title="Service Quality Rating (1-5)">🛎️ Service</th>
              <th title="Cleanliness Rating (1-5)">✨ Clean</th>
              <th title="Atmosphere Rating (1-5)">🕯️ Atmo</th>
              <th title="Value for Money (1-5)">💵 Value</th>
              <th title="Jev System One Telemetry">⚡ Jev Inference</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody id="matrix-table-body">
            <!-- Populated dynamically -->
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Deep Inspection Modal -->
  <div id="detail-modal-overlay" class="modal-overlay" style="display: none;">
    <div class="modal-panel glass-card detail-panel">
      <div class="modal-header">
        <div>
          <h3 id="modal-rest-name">Restaurant Name</h3>
          <p id="modal-reviewer-meta" class="subtitle">Reviewer &bull; Date</p>
        </div>
        <button id="close-detail-modal" class="close-btn">&times;</button>
      </div>

      <div class="modal-body detail-modal-body">
        <!-- Original Review Box -->
        <div class="detail-section">
          <h4>Original Google Review</h4>
          <div class="rating-row">
            <span id="modal-stars" class="stars-display">⭐⭐⭐⭐⭐</span>
            <span id="modal-rating-num" class="rating-badge">5.0</span>
          </div>
          <p id="modal-review-text" class="quote-text">Customer review body text goes here...</p>
        </div>

        <!-- LLM Executive Summary -->
        <div class="detail-section highlight-box">
          <div class="badge-row">
            <span id="modal-sentiment-pill" class="pill pill-positive">Positive</span>
            <span id="modal-score-pill" class="pill pill-neutral">Score: 4.8 / 5.0</span>
          </div>
          <h4 style="margin-top: 10px;">Executive Summary (Classification)</h4>
          <p id="modal-summary-text" class="summary-text">Summary text...</p>
        </div>

        <!-- Jev System One Telemetry Box -->
        <div id="modal-jev-box" class="detail-section jev-metrics-card" style="display: none;">
          <div class="jev-metrics-header">
            <div class="jev-model-tag">
              <span class="pulse-dot"></span>
              <span id="modal-jev-model">Jev 1.13 (System One)</span>
            </div>
            <div class="jev-quick-stats">
              <span class="stat-badge">⚡ Latency: <b id="modal-jev-latency">-</b></span>
              <span class="stat-badge">💰 Cost: <b id="modal-jev-cost">-</b></span>
              <span class="stat-badge">🎯 Confidence: <b id="modal-jev-conf">-</b></span>
            </div>
          </div>
          <p class="jev-desc">Evaluated with single-forward-pass inference over 9 typed questions (Choice, Score, Noul) at $0.042/Mtok input ($0 output).</p>
          <div id="modal-jev-probs" class="probs-grid"></div>
        </div>

        <!-- 5-Pillar Operational Breakdown -->
        <div class="detail-section">
          <h4>5-Pillar Operational Assessment</h4>
          <div class="pillars-grid">
            <div class="pillar-card">
              <div class="pillar-head">
                <span>🍽️ Food Quality</span>
                <b id="pillar-food-score">-</b>
              </div>
              <p id="pillar-food-note" class="pillar-note">Not specified</p>
            </div>

            <div class="pillar-card">
              <div class="pillar-head">
                <span>🛎️ Service</span>
                <b id="pillar-service-score">-</b>
              </div>
              <p id="pillar-service-note" class="pillar-note">Not specified</p>
            </div>

            <div class="pillar-card">
              <div class="pillar-head">
                <span>✨ Cleanliness</span>
                <b id="pillar-clean-score">-</b>
              </div>
              <p id="pillar-clean-note" class="pillar-note">Not specified</p>
            </div>

            <div class="pillar-card">
              <div class="pillar-head">
                <span>🕯️ Atmosphere</span>
                <b id="pillar-atmo-score">-</b>
              </div>
              <p id="pillar-atmo-note" class="pillar-note">Not specified</p>
            </div>

            <div class="pillar-card">
              <div class="pillar-head">
                <span>💵 Value for Money</span>
                <b id="pillar-val-score">-</b>
              </div>
              <p id="pillar-val-note" class="pillar-note">Not specified</p>
            </div>
          </div>
        </div>

        <!-- Dishes, Highlights, Complaints & Action Items -->
        <div class="detail-section">
          <div class="tags-columns">
            <div>
              <h5 class="col-title text-green">&check; Customer Highlights</h5>
              <ul id="modal-highlights-list" class="insights-list">
                <li>None</li>
              </ul>
            </div>

            <div>
              <h5 class="col-title text-red">&times; Complaints & Pain Points</h5>
              <ul id="modal-complaints-list" class="insights-list">
                <li>None</li>
              </ul>
            </div>
          </div>

          <div style="margin-top: 18px;">
            <h5 class="col-title text-accent">🍜 Dishes & Menu Items Mentioned</h5>
            <div id="modal-dishes-wrap" class="tags-wrap">
              <span class="tag">None</span>
            </div>
          </div>

          <div style="margin-top: 18px;">
            <h5 class="col-title text-yellow">💡 Action Items for Restaurant Owner</h5>
            <ul id="modal-actions-list" class="insights-list action-items">
              <li>None</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .app-container {
    padding-top: 32px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .page-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-dim);
    margin-bottom: 8px;
  }

  .breadcrumb a:hover {
    color: var(--text-main);
  }

  .breadcrumb .active {
    color: var(--accent-primary);
    font-weight: 600;
  }

  .page-header h1 {
    font-size: clamp(24px, 3.5vw, 34px);
    margin-bottom: 6px;
  }

  .subtitle {
    font-size: 14px;
    color: var(--text-muted);
    max-width: 720px;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  /* Guide Box */
  .guide-box {
    padding: 24px;
    background: rgba(15, 23, 20, 0.92);
    border: 1px solid rgba(16, 185, 129, 0.4);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  }

  .guide-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }

  .guide-header-title {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .guide-icon {
    font-size: 20px;
  }

  .close-guide-btn {
    background: none;
    border: none;
    color: var(--text-muted);
    font-size: 24px;
    cursor: pointer;
  }

  .guide-steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }

  .guide-step-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 18px;
  }

  .step-badge {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: var(--radius-full);
    background: var(--accent-primary);
    color: #fff;
    margin-bottom: 8px;
  }

  .guide-step-card h4 {
    font-size: 15px;
    margin-bottom: 6px;
  }

  .guide-step-card p {
    font-size: 12px;
    color: var(--text-dim);
    margin-bottom: 12px;
  }

  .guide-list {
    padding-left: 18px;
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .text-link {
    color: var(--accent-primary);
    text-decoration: underline;
  }

  /* Toast Banner */
  .toast-banner {
    padding: 12px 18px;
    border-radius: var(--radius-sm);
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.35);
    color: #a7f3d0;
    font-size: 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .toast-close {
    background: none;
    border: none;
    color: inherit;
    font-size: 18px;
    cursor: pointer;
  }

  /* KPI Grid */
  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 16px;
  }

  .kpi-card {
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .kpi-label {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-dim);
  }

  .kpi-value-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 8px 0;
  }

  .kpi-value {
    font-size: 32px;
    font-weight: 800;
    font-family: var(--font-heading);
    color: #ffffff;
    line-height: 1;
  }

  .kpi-icon {
    font-size: 22px;
    opacity: 0.6;
  }

  .kpi-sub {
    font-size: 12px;
    color: var(--text-muted);
  }

  .text-accent {
    color: var(--accent-primary);
  }
  .text-amber {
    color: var(--color-neutral);
